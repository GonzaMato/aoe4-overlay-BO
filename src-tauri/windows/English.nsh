; Tauri's English strings, with the reinstall page reworded: every option on that
; page ends with the app installed, so the labels say so instead of offering a
; bare "Uninstall"/"Do not uninstall" that reads like "do not install".
LangString addOrReinstall ${LANG_ENGLISH} "Install again over the current copy"
LangString alreadyInstalled ${LANG_ENGLISH} "Already installed"
LangString alreadyInstalledLong ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION} is already installed. Both options install it again and keep your builds and settings. To remove it instead, cancel and uninstall it from Windows Settings > Apps."
LangString appRunning ${LANG_ENGLISH} "{{product_name}} is open. Close it and try again."
LangString noPermissionToCloseApp ${LANG_ENGLISH} "Can't close {{product_name}}. Close it and try again."
LangString appRunningOkKill ${LANG_ENGLISH} "{{product_name}} is open.$\nClick OK to close it and continue."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose how to reinstall ${PRODUCTNAME}."
LangString chooseHowToInstall ${LANG_ENGLISH} "Choose how to install ${PRODUCTNAME} ${VERSION}."
LangString createDesktop ${LANG_ENGLISH} "Create desktop shortcut"
LangString dontUninstall ${LANG_ENGLISH} "Install over the current version"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Install over the current version (not available when going back to an older version)"
LangString failedToKillApp ${LANG_ENGLISH} "Couldn't close {{product_name}}. Close it and try again."
LangString installingWebview2 ${LANG_ENGLISH} "Installing WebView2..."
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer version of ${PRODUCTNAME} is installed. Both options install the older ${VERSION}. Back up your data first (Settings > Data): older versions may not read it."
LangString older ${LANG_ENGLISH} "older"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An $R4 version of ${PRODUCTNAME} is installed. Both options install ${VERSION} and keep your builds and settings."
LangString silentDowngrades ${LANG_ENGLISH} "Downgrades are disabled for this installer, can't proceed with the silent installer, please use the graphical interface installer instead.$\n"
LangString unableToUninstall ${LANG_ENGLISH} "Couldn't uninstall the current version."
LangString uninstallApp ${LANG_ENGLISH} "Uninstall first, then install again"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Uninstall the current version first, then install"
LangString unknown ${LANG_ENGLISH} "unknown"
LangString webview2AbortError ${LANG_ENGLISH} "Failed to install WebView2! The app can't run without it. Try restarting the installer."
LangString webview2DownloadError ${LANG_ENGLISH} "Error: Downloading WebView2 Failed - $0"
LangString webview2DownloadSuccess ${LANG_ENGLISH} "WebView2 bootstrapper downloaded successfully"
LangString webview2Downloading ${LANG_ENGLISH} "Downloading WebView2 bootstrapper..."
LangString webview2InstallError ${LANG_ENGLISH} "Error: Installing WebView2 failed with exit code $1"
LangString webview2InstallSuccess ${LANG_ENGLISH} "WebView2 installed successfully"
LangString deleteAppData ${LANG_ENGLISH} "Also delete my builds, settings and practice history"
; Used by windows/installer-hooks.nsh, which can't fill in {{product_name}}.
LangString aoe4AppOpenClose ${LANG_ENGLISH} "AoE4 Overlay is open.$\nClick OK to close it and continue."
LangString aoe4AppOpen ${LANG_ENGLISH} "AoE4 Overlay is open. Close it and try again."
LangString aoe4AppNotClosed ${LANG_ENGLISH} "Couldn't close AoE4 Overlay. Close it from the tray icon and try again."
