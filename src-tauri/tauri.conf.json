{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AoE4 Overlay",
  "version": "0.3.8",
  "identifier": "app.aoe4overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AoE4 Overlay — Builds",
        "visible": false,
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620
      },
      {
        "label": "overlay",
        "title": "AoE4 Overlay",
        "url": "overlay",
        "width": 380,
        "height": 480,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "AoE4 Overlay",
    "copyright": "Copyright (C) 2026 GonzaMato",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "targets": [
      "nsis"
    ],
    "shortDescription": "Build orders and practice for Age of Empires IV",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
